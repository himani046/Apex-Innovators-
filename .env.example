# Copy to .env and add your own API key. Never commit .env.
ANTHROPIC_API_KEY=
# Confirm model availability in your Anthropic Console before changing this value.
CLAUDE_MODEL=claude-haiku-4-5
MAX_AGENT_CALLS=12
MAX_AGENT_ITERATIONS=2
# Hard per-run budget across Claude calls; actual provider token usage is recorded when available.
MAX_LLM_TOKENS=120000
# Hard cap on actual Anthropic API attempts per run (including failed attempts).
MAX_LLM_CALLS=48
# Hard cap for the generalized all-contract workflow (separate from the legacy A1 run).
MAX_PORTFOLIO_AGENT_CALLS=300
# Stop repeating source-only clarification passes once this share of findings has verified citations.
CITATION_VERIFICATION_THRESHOLD=0.75

# Optional shared bearer token for audit reads, human decisions, and contract uploads.
# Use a long random secret; never commit the actual value in .env.
ODIN_API_TOKEN=
# Set ODIN_ENV=production to fail closed if ODIN_API_TOKEN is missing.
ODIN_ENV=development
